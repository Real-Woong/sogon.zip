{
  "name": "sogonzip",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "yarn@4.3.1",
  "workspaces": [
    "FE/App/mobile"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "worker:types": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler types workers/close-expired/worker-configuration.d.ts --config workers/close-expired/wrangler.jsonc --include-runtime false --check",
    "test": "node scripts/test.mjs",
    "verify": "yarn typecheck && yarn worker:types && yarn test && yarn build"
  },
  "dependencies": {
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "^7.16.0",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "typescript": "~5.6",
    "vite": "6.3.5",
    "wrangler": "^4.120.0"
  },
  "resolutions": {
    "@babel/types": "7.28.5",
    "vite": "6.3.5",
    "uuid": "^11.1.1"
  }
}
